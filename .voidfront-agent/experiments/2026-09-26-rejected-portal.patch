+void Sim::plan_traffic() {
+    // Derive straight passages between facing terrain edges. Work is bounded
+    // by the map rectangle pairs and the roster, only after canonical input.
+    struct Portal { bool horizontal; int low,high,begin,end; };
+    std::vector<Portal> portals;
+    const auto& terrain=map_terrain(map_);
+    for (size_t i=0;i<terrain.size();++i) for (size_t j=i+1;j<terrain.size();++j) {
+        const auto a=terrain[i],b=terrain[j];
+        if (std::max(a.min_x,b.min_x)<std::min(a.max_x,b.max_x)) {
+            const auto top=a.min_z<b.min_z?a:b,bottom=a.min_z<b.min_z?b:a;
+            if (bottom.min_z-top.max_z>=8*unit_radius)
+                portals.push_back({true,top.max_z,bottom.min_z,std::min(a.min_x,b.min_x),std::max(a.max_x,b.max_x)});
+        }
+        if (std::max(a.min_z,b.min_z)<std::min(a.max_z,b.max_z)) {
+            const auto left=a.min_x<b.min_x?a:b,right=a.min_x<b.min_x?b:a;
+            if (right.min_x-left.max_x>=8*unit_radius)
+                portals.push_back({false,left.max_x,right.min_x,std::min(a.min_z,b.min_z),std::max(a.max_z,b.max_z)});
+        }
+    }
+    for (const auto portal:portals) {
+        std::array<std::vector<uint32_t>,2> streams;
+        const auto along=[&](const Unit& u) { return portal.horizontal?u.x:u.z; };
+        const auto across=[&](const Unit& u) { return portal.horizontal?u.z:u.x; };
+        for (const auto& u:units_) {
+            if (u.hp<=0 || u.order!=Order::Move) continue;
+            const int start=along(u),goal=portal.horizontal?u.goal_x:u.goal_z;
+            const int direction=start<portal.begin-3*kScale && goal>portal.end+3*kScale?0:
+                (start>portal.end+3*kScale && goal<portal.begin-3*kScale?1:-1);
+            if (direction<0) continue;
+            // Traffic elsewhere on the map must not be diverted to this gap.
+            bool traverses=false;
+            auto a=nav::Point{u.x,u.z};
+            for (const auto b:navigation_.route(a,{u.goal_x,u.goal_z})) {
+                int64_t aa=portal.horizontal?a.x:a.z,bb=portal.horizontal?b.x:b.z;
+                int64_t az=portal.horizontal?a.z:a.x,bz=portal.horizontal?b.z:b.x;
+                if (aa>bb) { std::swap(aa,bb); std::swap(az,bz); }
+                const int64_t middle=(portal.begin+portal.end)/2;
+                if (aa<bb && aa<=middle && middle<=bb) {
+                    const int64_t transverse=az*(bb-aa)+(bz-az)*(middle-aa);
+                    traverses=transverse>=int64_t(portal.low+unit_radius)*(bb-aa) &&
+                        transverse<=int64_t(portal.high-unit_radius)*(bb-aa);
+                }
+                a=b;
+                if (traverses) break;
+            }
+            if (traverses) streams[direction].push_back(u.id);
+        }
+        if (streams[0].size()<2 || streams[1].size()<2) continue;
+        for (int direction=0;direction<2;++direction) {
+            auto& stream=streams[direction];
+            std::sort(stream.begin(),stream.end(),[&](uint32_t a,uint32_t b) {
+                const int za=across(units_[a-1]),zb=across(units_[b-1]);
+                return za!=zb?za<zb:a<b;
+            });
+            const int middle=(portal.low+portal.high)/2;
+            // Right-hand halves reverse for north/south travel.
+            const bool lower=(direction==0)==portal.horizontal;
+            const int first=(lower?portal.low:middle)+unit_radius+32;
+            const int last=(lower?middle:portal.high)-unit_radius-32;
+            const int lanes=1+(last-first)/(3*unit_radius);
+            if (lanes<1) continue;
+            // Begin fan-out before this stream's nearest final goal. Sending
+            // every actor beyond the opposing spawn caused early finishers to
+            // turn back into their own lane and seal its remaining traffic.
+            int far=direction==0?std::numeric_limits<int>::max():std::numeric_limits<int>::min();
+            for (const auto id:stream) {
+                const auto& unit=units_[id-1];
+                const int goal=portal.horizontal?unit.goal_x:unit.goal_z;
+                far=direction==0?std::min(far,goal):std::max(far,goal);
+            }
+            far+=direction==0?-3*kScale:3*kScale;
+            far=direction==0?std::max(far,portal.end+3*kScale):std::min(far,portal.begin-3*kScale);
+            far=std::clamp(far,kScale+unit_radius,(portal.horizontal?width():height())*kScale-kScale-unit_radius);
+            std::vector<std::vector<uint32_t>> lane_streams(static_cast<size_t>(lanes));
+            for (size_t rank=0;rank<stream.size();++rank)
+                lane_streams[rank*static_cast<size_t>(lanes)/stream.size()].push_back(stream[rank]);
+            for (int lane_index=0;lane_index<lanes;++lane_index) {
+              auto& members=lane_streams[static_cast<size_t>(lane_index)];
+              const int lane=first+lane_index*3*unit_radius;
+              std::sort(members.begin(),members.end(),[&](uint32_t a,uint32_t b) {
+                  const auto& ua=units_[a-1]; const auto& ub=units_[b-1];
+                  const int pa=along(ua),pb=along(ub);
+                  if (pa!=pb) return direction==0?pa>pb:pa<pb;
+                  const int da=std::abs(across(ua)-lane),db=std::abs(across(ub)-lane);
+                  return da!=db?da<db:a<b;
+              });
+              for (size_t rank=0;rank<members.size();++rank) {
+                auto& u=units_[members[rank]-1];
+                if (u.traffic_planned) continue;
+                // Distinct physical merge gates form an ordered queue, rather
+                // than sending every member to the same exact approach point.
+                const int spacing=2*unit_radius+movement_speed;
+                const int near=direction==0?portal.begin-3*kScale-static_cast<int>(rank)*spacing:
+                    portal.end+3*kScale+static_cast<int>(rank)*spacing;
+                const nav::Point entry=portal.horizontal?nav::Point{near,lane}:nav::Point{lane,near};
+                const nav::Point exit=portal.horizontal?nav::Point{far,lane}:nav::Point{lane,far};
+                if (!navigation_.valid(entry) || !navigation_.valid(exit) || !navigation_.clear(entry,exit) ||
+                    navigation_.route({u.x,u.z},entry).empty() || navigation_.route(exit,{u.goal_x,u.goal_z}).empty()) continue;
+                u.traffic_path={entry,exit}; u.traffic_planned=true;
+                const int sign=direction==0?1:-1;
+                u.traffic_heading=portal.horizontal?nav::Point{sign,0}:nav::Point{0,sign};
+                const int low=(lower?portal.low:middle)+unit_radius;
+                const int high=(lower?middle:portal.high)-unit_radius;
+                u.traffic_corridor=portal.horizontal?
+                    nav::Rect{portal.begin-unit_radius,low,portal.end+unit_radius,high}:
+                    nav::Rect{low,portal.begin-unit_radius,high,portal.end+unit_radius};
+                u.path.clear(); u.detour.clear(); u.blocked_ticks=0; u.route_goal={-1,-1};
+              }
+            }
+        }
+    }
